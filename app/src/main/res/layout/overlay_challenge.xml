<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:padding="8dp">

    <View
        android:id="@+id/overlay_handle"
        android:layout_width="56dp"
        android:layout_height="14dp"
        android:layout_gravity="center_horizontal"
        android:background="#55FFFFFF" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btn_overlay_neutral"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="@string/role_neutral"
            android:textAllCaps="false"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_overlay_look_left"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="@string/role_look_left"
            android:textAllCaps="false"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_overlay_look_right"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="@string/role_look_right"
            android:textAllCaps="false"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_overlay_blink"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="@string/role_blink"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </GridLayout>

    <Button
        android:id="@+id/btn_overlay_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="6dp"
        android:text="✕"
        android:textSize="12sp" />
</LinearLayout>
