<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editor_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_editor"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editor_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_apply"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/editor_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:minHeight="140dp"
        android:background="?attr/colorSurfaceVariant">

        <ImageView
            android:id="@+id/iv_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <com.suryasukma.vcamtest.ui.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/progress_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_processing"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="132dp"
        android:padding="16dp">

        <!-- Crop -->
        <LinearLayout
            android:id="@+id/panel_crop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_free"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/aspect_free" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_1_1"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:1" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_4_3"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:3" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_3_4"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3:4" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_16_9"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_9_16"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:16" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_crop"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_reset_crop"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Rotate / flip -->
        <LinearLayout
            android:id="@+id/panel_rotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ed_rotate_left"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/desc_rotate_left"
                app:icon="@drawable/ic_rotate_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ed_rotate_right"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/desc_rotate_right"
                app:icon="@drawable/ic_rotate_right" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ed_flip_h"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/desc_flip_h"
                app:icon="@drawable/ic_mirror" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ed_flip_v"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/desc_flip_v"
                app:icon="@drawable/ic_flip_vertical" />
        </LinearLayout>

        <!-- Adjust -->
        <LinearLayout
            android:id="@+id/panel_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_brightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_brightness"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-100"
                android:valueTo="100"
                android:stepSize="1"
                android:value="0" />

            <TextView
                android:id="@+id/tv_contrast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_contrast"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_contrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-100"
                android:valueTo="100"
                android:stepSize="1"
                android:value="0" />

            <TextView
                android:id="@+id/tv_saturation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_saturation"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_saturation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-100"
                android:valueTo="100"
                android:stepSize="1"
                android:value="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_adjust"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_reset_adjust"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Trim (video only) -->
        <LinearLayout
            android:id="@+id/panel_trim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_trim_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/slider_trim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1000"
                app:values="@array/trim_default_values" />

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_speed"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.25"
                android:valueTo="4"
                android:stepSize="0.25"
                android:value="1" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_crop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_crop"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_crop"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_rotate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_rotate"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_rotate_right"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_adjust"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_adjust"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_tune"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_trim"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_trim"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_trim"
            app:iconGravity="top" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
